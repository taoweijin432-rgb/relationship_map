[Unit]
Description=Relationship nightly versioned release
Wants=network-online.target
After=network-online.target relationship-graph-tunnel.service nginx.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/relationship-map
EnvironmentFile=/etc/relationship-map/mysql.env
ExecStart=/srv/relationship-map/backend/.venv/bin/python -m relationship_query.update.nightly run --scheduled --config /etc/relationship-map/nightly.json
ExecStopPost=/srv/relationship-map/backend/.venv/bin/python -m relationship_query.update.nightly recover --config /etc/relationship-map/nightly.json
TimeoutStartSec=90min
TimeoutStopSec=6min
KillMode=control-group
UMask=0077
