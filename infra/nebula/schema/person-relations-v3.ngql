-- Model uuid-relations-v3 = uuid-facts-v1.ngql + this file in a NEW space.
-- Store each evidence pair once, from lower person VID to higher person VID.
-- Relation rank is snapshot-local, NOT graph_edge_mapping.id.

CREATE EDGE same_company (
    entity_vid STRING NOT NULL,
    left_fact_rank INT64 NOT NULL,
    right_fact_rank INT64 NOT NULL
) COMMENT = 'Same standard company evidence pair';

CREATE EDGE company_overlap (
    entity_vid STRING NOT NULL,
    left_fact_rank INT64 NOT NULL,
    right_fact_rank INT64 NOT NULL,
    overlap_start_month INT32 NOT NULL,
    overlap_end_month INT32 NOT NULL
) COMMENT = 'Overlapping work evidence at projection reference month';

CREATE EDGE same_school (
    entity_vid STRING NOT NULL,
    left_fact_rank INT64 NOT NULL,
    right_fact_rank INT64 NOT NULL
) COMMENT = 'Same standard school without inferred temporal overlap';

CREATE EDGE same_major (
    entity_vid STRING NOT NULL,
    left_fact_rank INT64 NOT NULL,
    right_fact_rank INT64 NOT NULL
) COMMENT = 'Same standard major without requiring same school or time';

-- No inferred acquaintance, property indexes, TTL or persisted indirect pairs.
